{
	"extends": "@blockleaf/tsconfig/react-library.json",
	"compilerOptions": {
		"allowJs": true,
		"incremental": true,
		"paths": {
			"@/*": ["./*"]
		},
		"plugins": [{ "name": "next" }]
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules", ".next"]
}
