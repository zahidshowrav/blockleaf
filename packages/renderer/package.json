{
	"name": "@blockleaf/renderer",
	"version": "0.1.0",
	"description": "Renders a stored Blockleaf document to React or an HTML string, with no editor and no ProseMirror.",
	"license": "MIT",
	"homepage": "https://blockleaf.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zahidshowrav/blockleaf.git",
		"directory": "packages/renderer"
	},
	"bugs": {
		"url": "https://github.com/zahidshowrav/blockleaf/issues"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.js"
		},
		"./html": {
			"types": "./dist/html.d.ts",
			"import": "./dist/html.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check:packaging": "publint --strict && attw --pack . --profile esm-only",
		"size": "size-limit"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@blockleaf/editor": "workspace:*",
		"@blockleaf/eslint-config": "workspace:*",
		"@blockleaf/tsconfig": "workspace:*",
		"@size-limit/preset-big-lib": "14.2.0",
		"@tiptap/core": "3.31.4",
		"@testing-library/react": "16.3.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"eslint": "10.12.0",
		"jsdom": "30.1.2",
		"publint": "0.3.25",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"size-limit": "14.2.0",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"unrun": "0.3.1",
		"vitest": "5.0.3"
	}
}
