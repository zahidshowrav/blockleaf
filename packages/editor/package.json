{
	"name": "@blockleaf/editor",
	"version": "0.0.3",
	"description": "A Notion-style block editor on Tiptap. Headless-first, no CSS framework, versioned JSON out.",
	"license": "MIT",
	"homepage": "https://blockleaf.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zahidshowrav/blockleaf.git",
		"directory": "packages/editor"
	},
	"bugs": {
		"url": "https://github.com/zahidshowrav/blockleaf/issues"
	},
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./extensions": {
			"types": "./dist/extensions.d.ts",
			"import": "./dist/extensions.js"
		},
		"./validate": {
			"types": "./dist/validate.d.ts",
			"import": "./dist/validate.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown && cp src/styles/blockleaf.css dist/styles.css",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check:packaging": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css",
		"size": "size-limit"
	},
	"dependencies": {
		"@tiptap/core": "3.31.4",
		"@tiptap/extension-highlight": "3.31.4",
		"@tiptap/extension-link": "3.31.4",
		"@tiptap/extension-table": "3.31.4",
		"@tiptap/extension-task-item": "3.31.4",
		"@tiptap/extension-task-list": "3.31.4",
		"@tiptap/extension-underline": "3.31.4",
		"@tiptap/extension-unique-id": "3.31.4",
		"@tiptap/pm": "3.31.4",
		"@tiptap/react": "3.31.4",
		"@tiptap/starter-kit": "3.31.4",
		"@tiptap/suggestion": "3.31.4"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"zod": "^3.24.0"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@blockleaf/eslint-config": "workspace:*",
		"@blockleaf/tsconfig": "workspace:*",
		"@size-limit/preset-big-lib": "14.2.0",
		"@testing-library/react": "16.3.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"eslint": "10.12.0",
		"jsdom": "30.1.2",
		"publint": "0.3.25",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"size-limit": "14.2.0",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"unrun": "0.3.1",
		"vitest": "5.0.3",
		"zod": "^3.25.76"
	},
	"keywords": [
		"tiptap",
		"prosemirror",
		"editor",
		"rich-text",
		"notion",
		"block-editor",
		"react"
	]
}
